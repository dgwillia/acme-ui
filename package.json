{
  "name": "@acme/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Acme UI — a small AI-ready design system proof of concept: Figma variables → DTCG tokens → CSS → React components → Storybook → agent-built screens.",
  "scripts": {
    "tokens:from-figma": "node sync/checksum.mjs && node sync/snapshot-to-tokens.mjs",
    "tokens:to-figma": "node sync/tokens-to-snapshot.mjs",
    "tokens:build": "node style-dictionary.config.mjs",
    "design-md:build": "node scripts/build-design-md.mjs",
    "build": "npm run tokens:build && npm run design-md:build && tsc --noEmit && vite build",
    "dev": "vite",
    "lint": "stylelint \"src/**/*.css\" && eslint src",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "check": "npm run tokens:build && npm run design-md:build && git diff --exit-code DESIGN.md src/styles/tokens.css && npm run lint && npm run typecheck"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-mcp": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.14.0",
    "storybook": "^10.6.5",
    "style-dictionary": "^4.3.0",
    "stylelint": "^16.10.0",
    "stylelint-declaration-strict-value": "^1.10.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^5.4.10"
  }
}
